{
  "model": "opus",
  "effortLevel": "high",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git worktree list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(npx vitest run:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run lint:*)",
      "Bash(npx prettier --check:*)",
      "Bash(bash scripts/overlap.sh:*)"
    ],
    "deny": [
      "mcp__chrome-devtools__get_network_request"
    ]
  },
  "skillOverrides": {
    "claude-api": "off",
    "claude-in-chrome": "off",
    "init": "off",
    "keybindings-help": "off",
    "dataviz": "name-only",
    "schedule": "name-only",
    "anthropic-skills:docx": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:xlsx": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:import-memory": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.mjs"
          }
        ]
      }
    ]
  }
}
