{
  // The app's modules and tests. Vite strips types without checking them, so
  // this config is the type gate (`npm run typecheck`). The app reaches the
  // engine through `@windsor/engine` only; its tests may also import the
  // engine's fixtures by subpath (`@windsor/engine/__fixtures__/…`).
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"]
}
