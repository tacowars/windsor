{
  // The build config excludes tests and __fixtures__ (they are Node-only and
  // must not reach the browser bundle), so this config typechecks exactly
  // those files.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["src/**/*.test.ts", "src/**/__fixtures__/**/*.ts", "src/**/*.d.ts"],
  // The FM worklet's own project checks its modules and their tests
  // (`src/worklet/fm/tsconfig.json`, #654): pulled in here they would be read
  // under `noUncheckedIndexedAccess`, which that project turns off.
  "exclude": ["src/worklet/fm/**"]
}
