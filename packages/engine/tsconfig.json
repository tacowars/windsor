{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": []
  },
  // Eleven worklet modules are read by the main thread too (#656): the algorithm
  // table, the wave ids, the envelope curve, the mode ids, the patch defaults,
  // the constants they use, the voice target table and curve
  // (windsor#419), the Formant vowels (windsor#331), and the macro mappings
  // the voice applies (windsor#560) and what one plays (windsor#566). They sit under `worklet/fm/`, which is
  // excluded below and checked by its own project, so they are listed here by
  // name and compiled by both — under this project's stricter flags as well.
  "files": [
    "src/worklet/fm/algorithms.ts",
    "src/worklet/fm/waveIds.ts",
    "src/worklet/fm/envelope.ts",
    "src/worklet/fm/fmConstants.ts",
    "src/worklet/fm/modeIds.ts",
    "src/worklet/fm/patchDefaults.ts",
    "src/worklet/fm/voiceTargetTables.ts",
    "src/worklet/fm/voiceTargetValue.ts",
    "src/worklet/fm/formantTables.ts",
    "src/worklet/fm/macroMappings.ts",
    "src/worklet/fm/macroShape.ts"
  ],
  "include": ["src", "src/**/*.json"],
  "exclude": [
    "src/worklet/advancedDrive/**",
    "src/worklet/retro/**",
    "src/worklet/phaser/**",
    "src/worklet/tape/**",
    "src/worklet/delay/**",
    "src/worklet/eq/**",
    "src/**/*.test.ts",
    "src/**/__fixtures__/**",
    "src/worklet/fm/**",
    "src/worklet/compressor/**",
    "src/worklet/meter/**",
    "src/worklet/reverb/**"
  ]
}
